    "threads": 96,
    "quast_batch_size": 500,
    "quast_jobs": 24,
    "quast_threads": 4,
    "progress_every_percent": 5,
    "quast_cmd": "${PHILO_QUAST}",
    "checkm2_cmd": "${PHILO_CHECKM2}",
    "skani_cmd": "${PHILO_SKANI}",
    "quast_min_length": 3500000,
    "quast_max_length": 4800000,
    "quast_max_contigs": 500,
    "quast_min_n50": 25000,
    "quast_max_ns_per_100kbp": 1000,
    "quast_very_good_min_length": 3600000,
    "quast_very_good_max_length": 4600000,
    "quast_very_good_max_contigs": 200,
    "quast_very_good_min_n50": 100000,
    "quast_very_good_max_ns_per_100kbp": 100,
    "checkm2_min_completeness": 95.0,
    "checkm2_max_contamination": 5.0,
    "checkm2_very_good_min_completeness": 98.0,
    "checkm2_very_good_max_contamination": 2.0,
