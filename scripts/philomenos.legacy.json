{
  "st2_metadata": {
    "fastas": "${PHILO_DATA_DIR}/fastas",
    "mlst": "${PHILO_DATA_DIR}/mlst",
    "out_root": ".",
    "run_id": "metadata",
    "target_st": "2",
    "scheme": null,
    "chunk_size": 300,
    "force": false,
    "skip_metadata": false,
    "copy_fastas": false
  },
  "quality": {
