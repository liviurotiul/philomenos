    "ani_very_good_min": 99.0,
    "ani_very_good_min_aligned_fraction": 90.0
  },
  "phylo": {
    "input_run": "runs/st2_quality_20260624",
    "out_root": "runs",
    "run_id": "st2_phylo_20260624",
    "reference_fasta": "${PHILO_REFERENCE_DIR}/ACICU_CP000863.fasta",
    "reference_gbk": "${PHILO_REFERENCE_DIR}/ACICU_CP000863.gbk",
    "reference_gff": null,
    "reference_mask_bed": "${PHILO_REFERENCE_DIR}/ACICU_CP000863.mask.bed",
    "threads": 96,
    "snippy_jobs": 48,
    "snippy_threads": 2,
    "conda_cmd": "${PHILO_CONDA}",
    "snippy_env": "${PHILO_SNIPPY_ENV}",
    "gubbins_env": "${PHILO_GUBBINS_ENV}",
    "treetime_env": "${PHILO_TREETIME_ENV}",
    "gubbins_iterations": 5,
    "gubbins_min_snps": 3,
